	<annotations>
		<text id="0" type="text/plain" rect="(99.0, 74.0, 131.0, 37.0)" font-family="Microsoft JhengHei UI" font-size="16">流程圖一</text>
		<text id="1" type="text/plain" rect="(483.0, 74.0, 114.0, 47.0)" font-family="Microsoft JhengHei UI" font-size="16">流程圖二</text>
		<text id="2" type="text/plain" rect="(32.5, 460.0, 146.25, 33.0)" font-family="Microsoft JhengHei UI" font-size="16">流程圖三、四</text>
		<text id="3" type="text/plain" rect="(146.25, 1050.0, 111.25, 56.25)" font-family="Microsoft JhengHei UI" font-size="16">用於刪除不重要的資料。</text>
		<text id="4" type="text/plain" rect="(261.25, 1052.5, 125.0, 96.0)" font-family="Microsoft JhengHei UI" font-size="16">用於sample資料。將data分成test data和training data</text>
		<text id="5" type="text/plain" rect="(655.0, 477.5, 133.75, 54.0)" font-family="Microsoft JhengHei UI" font-size="16">無正規化的迴歸</text>
		<text id="6" type="text/plain" rect="(722.5, 547.5, 282.5, 65.75)" font-family="Microsoft JhengHei UI" font-size="16">利用LI regularization，並設定alpha值。我將alpha值設定在名稱後方方便辨識。</text>
		<text id="7" type="text/plain" rect="(726.25, 1277.5, 241.25, 75.0)" font-family="Microsoft JhengHei UI" font-size="16">利用L2 regularization，並設定alpha值。我將alpha值設定在名稱後方方便辨識。</text>
		<text id="8" type="text/plain" rect="(905.0, 1033.75, 148.75, 41.25)" font-family="Microsoft JhengHei UI" font-size="16">用於得出結果</text>
	</annotations>
